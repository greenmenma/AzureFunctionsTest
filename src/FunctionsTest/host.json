{
  "version": "2.0",
  "logging": {
    "logLevel": {
      "default": "Information",
      "Host.Triggers.DurableTask": "Information"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  },
  "extensions": {
    "queues": {
      "maxDequeueCount": 3,
      "visibilityTimeout": "00:00:05"
    },
    "serviceBus": {
      "maxConcurrentCalls": 4,
      "autoCompleteMessages": true
    },
    "durableTask": {
      "hubName": "FunctionsTestHub"
    },
    "mcp": {
      "serverName": "FunctionsTest",
      "serverVersion": "1.0.0",
      "instructions": "Azure Functions 検証用の MCP サーバーです。get_time / add ツールを提供します。"
    }
  }
}
